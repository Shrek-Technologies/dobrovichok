<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-help-requests-ward-names" author="dobrovichek">
        <addColumn tableName="help_requests">
            <column name="ward_first_name" type="VARCHAR(60)" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="ward_last_name" type="VARCHAR(60)" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="ward_patronymic" type="VARCHAR(60)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
