<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="006-user-credentials" author="dobrovichek">
        <createTable tableName="user_credentials">
            <column name="user_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_normalized" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="user_credentials"
                columnNames="phone_normalized"
                constraintName="uq_user_credentials_phone_normalized"/>

        <addForeignKeyConstraint
                baseTableName="user_credentials"
                baseColumnNames="user_id"
                constraintName="fk_user_credentials_profile"
                referencedTableName="user_profiles"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
