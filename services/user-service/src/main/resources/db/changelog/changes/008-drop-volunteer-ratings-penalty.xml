<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="008-drop-volunteer-ratings-penalty-column" author="dobrovichek">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="volunteer_ratings" columnName="penalty"/>
        </preConditions>
        <delete tableName="volunteer_ratings">
            <where>penalty = true</where>
        </delete>
        <dropColumn tableName="volunteer_ratings" columnName="penalty"/>
    </changeSet>
</databaseChangeLog>
